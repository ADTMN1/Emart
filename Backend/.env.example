# Server Configuration
NODE_ENV=development
PORT=5000
API_VERSION=v1

# Database Configuration (Supabase)
# Transaction pooler (port 6543) for application queries with pgbouncer
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session mode (port 5432) for Prisma migrations
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/auth/google/callback

# Default Admin User (for seeding)
ADMIN_EMAIL=admin@emart.com
ADMIN_PASSWORD=Admin@123456

# Google Gemini AI Configuration
GEMINI_API_KEY=your-gemini-api-key-here

# Supabase Configuration
# Get these from your Supabase project settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-supabase-secret-key
# WARNING: NEVER expose SUPABASE_SECRET_KEY to the frontend!
# Use SUPABASE_PUBLISHABLE_KEY for frontend if needed.

# Crypto receiving wallets are managed by an administrator in Admin > Wallets.
# Addresses and QR-code URLs are stored in the database and never in frontend code.

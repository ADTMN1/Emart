{
  "name": "emart-backend",
  "version": "1.0.0",
  "description": "Marcari23 Global Proxy Shopping Backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "test:import": "tsx --test src/services/import/*.test.ts src/controllers/product-import.controller.test.ts",
    "test:cj": "tsx --test src/services/suppliers/cj/*.test.ts",
    "test:storage": "STORAGE_ROOT=/tmp/emart-storage-test STORAGE_PUBLIC_BASE_URL=https://cdn.emart.test tsx --test --test-concurrency=1 src/config/storage.test.ts src/services/local-file-storage.service.test.ts src/services/product-image-storage.service.test.ts src/services/seller-shop-media-storage.service.test.ts src/services/seller-document-storage.service.test.ts",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:restore-admin": "tsx prisma/restore-admin.ts",
    "prisma:reset": "prisma migrate reset",
    "db:push": "prisma db push",
    "db:seed": "npm run prisma:seed"
  },
  "keywords": [
    "ecommerce",
    "proxy-shopping",
    "api"
  ],
  "author": "Marcari23",
  "license": "MIT",
  "dependencies": {
    "@getbrevo/brevo": "^6.0.3",
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^5.7.1",
    "@types/multer": "^2.2.0",
    "@types/yauzl": "^3.4.0",
    "bcrypt": "^5.1.1",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "google-auth-library": "^11.0.2",
    "googleapis": "^178.1.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.3.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/form-data": "^2.2.1",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.10.5",
    "axios": "^1.20.0",
    "form-data": "^4.0.6",
    "prisma": "^5.7.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 String                   @id @default(uuid())
  email              String                   @unique
  password           String
  firstName          String?
  lastName           String?
  phone              String?
  role               UserRole                 @default(CUSTOMER)
  suspended          Boolean                  @default(false)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  addresses          Address[]
  cart               Cart?
  orders             Order[]
  walletTransactions WalletTransaction[]
  wallet             Wallet?
  warehousePackages  WarehousePackage[]
  favorites          Favorite[]
  importRuns          ImportRun[]
  productRatings     ProductRating[]
  /// Seller foundation (Phase 5). A user may hold at most one of each.
  sellerApplication  SellerApplication?      @relation("SellerApplication")
  sellerProfile      SellerProfile?          @relation("SellerProfile")
  /// Seller Agreement acceptance (Phase 8). One acceptance per user; only
  /// the current server-controlled version satisfies a new application.
  sellerAgreementAcceptance SellerAgreementAcceptance?
  /// Admin ↔ Seller messaging (Phase 7). Messages are sent by a user and
  /// notifications target the recipient user.
  sentMessages          Message[]             @relation("SenderMessages")
  sentSupportMessages   SupportMessage[]      @relation("SenderSupportMessages")
  notifications         Notification[]        @relation("UserNotifications")
  supportConversations  SupportConversation[] @relation("UserSupportConversations")
  loanRequests          LoanRequest[]
  reviewedLoanRequests  LoanRequest[]       @relation("LoanRequestReviewedBy")

  @@index([email])
  @@map("users")
}

model Address {
  id                String             @id @default(uuid())
  userId            String
  fullName          String
  addressLine       String
  city              String
  state             String?
  postalCode        String
  country           String
  countryCode       String
  phone             String
  isDefault         Boolean            @default(false)
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  ordersAsBilling   Order[]            @relation("BillingAddress")
  ordersAsShipping  Order[]            @relation("ShippingAddress")
  warehousePackages WarehousePackage[]

  @@index([userId])
  @@map("addresses")
}

model Category {
  id       String    @id @default(uuid())
  name     String    @unique
  icon     String
  count    Int       @default(0)
  color    String
  products Product[]

  @@index([name])
  @@map("categories")
}

model Product {
  id                       String           @id @default(uuid())
  sku                      String?          @unique
  name                     String
  description              String
  image                    String?
  images                   String[]         @default([])
  price                    Float
  estimatedPriceUsd        Float
  condition                ProductCondition
  seller                   String
  sellerType               SellerType
  source                   String
  domesticShipping         Float
  internationalShippingUsd Float
  serviceFee               Float
  categoryId               String
  tags                     String[]
  isNew                    Boolean          @default(false)
  isBestSeller             Boolean          @default(false)
  rating                   Float?
  reviewCount              Int?
  stock                    Int              @default(1)
  isAvailable              Boolean          @default(true)
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt
  cartItems                CartItem[]
  orderItems               OrderItem[]
  category                 Category         @relation(fields: [categoryId], references: [id])
  productImages            ProductImage[]
  favorites                Favorite[]
  productRatings           ProductRating[]
  /// Phase 6: owning seller profile. null = admin/catalog product.
  sellerId                 String?
  sellerProfile            SellerProfile?  @relation("SellerProducts", fields: [sellerId], references: [id])
  /// Denormalized rating aggregate (maintained by the rating API on write).
  ratingAgg                Float            @default(0)
  /// Number of distinct user ratings backing ratingAgg.
  ratingCount              Int              @default(0)
  /// Source type: SELLER (marketplace/seller) or CJ (CJdropshipping supplier).
  sourceType               SourceType       @default(SELLER)
  /// External CJ product ID (for CJ-sourced products).
  externalProductId        String?
  /// External CJ supplier ID (for CJ-sourced products).
  supplierId               String?
  /// Raw CJ product/variant data for reference (JSON).
  supplierData             Json?

  @@index([categoryId])
  @@index([categoryId, isAvailable, createdAt])
  @@index([categoryId, isAvailable, estimatedPriceUsd])
  @@index([isAvailable, categoryId, isBestSeller])
  @@index([isAvailable, condition])
  @@index([isAvailable, createdAt])
  @@index([isAvailable])
  @@index([isNew])
  @@index([isBestSeller])
  @@index([sellerId, updatedAt])
  @@index([source])
  @@index([condition])
  @@index([estimatedPriceUsd])
  @@index([createdAt])
  @@index([name])
  @@index([sourceType])
  @@unique([externalProductId])
  @@map("products")
}

/// One bulk product import run (Phase 3: CREATE mode, CSV only).
model ImportRun {
  id          String       @id @default(uuid())
  userId      String
  filename    String
  fileHash    String
  mode        ImportMode   @default(CREATE)
  status      ImportStatus @default(PROCESSING)
  totalRows   Int          @default(0)
  successRows Int          @default(0)
  warningRows Int          @default(0)
  errorRows   Int          @default(0)
  /// Per-row results: rowNumber, sku, status, errors, warnings, productId.
  rowResults  Json
  sourceRows  Json?
  createdAt   DateTime     @default(now())
  completedAt DateTime?
  updatedAt   DateTime     @updatedAt
  user        User         @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([status])
  @@map("import_runs")
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  path      String
  url       String?
  isPrimary Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([productId, isPrimary, sortOrder])
  @@index([isPrimary])
  @@map("product_images")
}

model CryptoWallet {
  id        String   @id @default(uuid())
  currency  String
  network   String
  address   String   @unique
  qrCodeUrl String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([currency, network])
  @@index([isActive, currency, network])
  @@map("crypto_wallets")
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  items     CartItem[]
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  productId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@index([cartId])
  @@index([productId])
  @@map("cart_items")
}

model Order {
  id                    String             @id @default(uuid())
  userId                String
  orderNumber           String             @unique
  status                OrderStatus        @default(PENDING)
  subtotal              Float
  serviceFees           Float
  domesticShipping      Float
  internationalShipping Float
  insurance             Float
  total                 Float
  shippingMethod        String
  shippingCarrier       String?
  trackingNumber        String?
  estimatedDelivery     DateTime?
  billingAddressId      String
  shippingAddressId     String
  notes                 String?
  paymentStatus         PaymentStatus      @default(PENDING)
  paymentMethod         String?
  paymentProofUrl       String?
  /// UTC timestamp when an admin verified/confirmed the payment (Phase 3).
  paidAt                DateTime?
  /// Free-text admin note: rejection reason or other payment-management note (Phase 3).
  paymentNote           String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  items                 OrderItem[]
  billingAddress        Address            @relation("BillingAddress", fields: [billingAddressId], references: [id])
  shippingAddress       Address            @relation("ShippingAddress", fields: [shippingAddressId], references: [id])
  user                  User               @relation(fields: [userId], references: [id])
  shipment              Shipment?
  warehousePackages     WarehousePackage[]
  conversations         Conversation[]
  notifications         Notification[]

  @@index([userId])
  @@index([userId, createdAt])
  @@index([orderNumber])
  @@index([status])
  @@index([status, createdAt])
  @@index([paymentStatus, createdAt])
  @@map("orders")
}

model OrderItem {
  id                         String  @id @default(uuid())
  orderId                    String
  productId                  String
  quantity                   Int
  priceAtPurchase            Float
  serviceFeeAtPurchase       Float
  domesticShippingAtPurchase Float
  productSnapshot            Json
  order                      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product                    Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([orderId, productId])
  @@index([productId])
  @@map("order_items")
}

model WarehousePackage {
  id               String        @id @default(uuid())
  userId           String
  orderId          String?
  packageNumber    String        @unique
  status           PackageStatus @default(RECEIVED)
  weight           Float?
  dimensions       String?
  photos           String[]
  inspectionNotes  String?
  storageLocation  String?
  receivedAt       DateTime      @default(now())
  expiresAt        DateTime?
  addressId        String?
  consolidatedWith String[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  address          Address?      @relation(fields: [addressId], references: [id])
  order            Order?        @relation(fields: [orderId], references: [id])
  user             User          @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([userId, status, createdAt])
  @@index([orderId])
  @@index([orderId, status])
  @@index([status])
  @@index([status, createdAt])
  @@map("warehouse_packages")
}

model Shipment {
  id                String         @id @default(uuid())
  orderId           String         @unique
  trackingNumber    String         @unique
  carrier           String
  status            ShipmentStatus @default(PENDING)
  weight            Float?
  dimensions        String?
  shippingCost      Float
  events            Json[]
  shippedAt         DateTime?
  estimatedDelivery DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  order             Order          @relation(fields: [orderId], references: [id])
  /// In-app notifications raised for this shipment's lifecycle events. Rows
  /// are removed with the shipment so unread counts can never reference a
  /// shipment that no longer exists.
  notifications     Notification[]

  @@index([orderId])
  @@index([trackingNumber])
  @@index([status, createdAt])
  @@map("shipments")
}

model Wallet {
  id        String   @id @default(uuid())
  userId    String   @unique
  balance   Float    @default(0)
  currency  String   @default("USD")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("wallets")
}

/// Seller application: one per user, reused for resubmission after rejection
/// so a user can never accumulate duplicate application records.
model SellerApplication {
  id                String        @id @default(uuid())
  /// Unique per user: an application is created once and REUSED for
  /// resubmission, never duplicated. Backed by the DB unique constraint.
  userId            String        @unique
  storeName         String
  /// Not part of the application form; kept on the model/profile editor.
  storeDescription  String        @default("")
  /// Applicant contact used for review + approval notifications. Defaults to
  /// the account email when the applicant does not supply one.
  email             String        @default("")
  /// Private path of the uploaded identity document (never exposed). Only a
  /// signed URL minted by the admin-only endpoint can read it.
  idDocumentPath    String        @default("")
  idDocumentMimeType String?
  emergencyContact  String?
  address           String        @default("")
  status            SellerStatus  @default(PENDING)
  rejectionReason   String?
  reviewedAt        DateTime?
  reviewedBy        String?
  submittedAt       DateTime      @default(now())
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  user              User          @relation("SellerApplication", fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, submittedAt])
  @@map("seller_applications")
}

/// Seller identity: exactly one per user (DB-enforced), created on approval.
model SellerProfile {
  id               String       @id @default(uuid())
  userId           String       @unique
  storeName        String
  storeDescription String
  status           SellerStatus @default(APPROVED)
  suspendedAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  user             User         @relation("SellerProfile", fields: [userId], references: [id], onDelete: Cascade)
  products         Product[]    @relation("SellerProducts")
  conversations    Conversation[]
  paymentMethods   SellerPaymentMethod[]

  // Public storefront media. The URL is what frontends render; the storage
  // path is kept private so replacements/removals can clean up the old object.
  logoUrl          String?
  bannerUrl        String?
  logoPath         String?
  bannerPath       String?

  @@index([status])
  @@map("seller_profiles")
}

/// Seller payout methods — card, bank, crypto, etc. One per method type per seller.
model SellerPaymentMethod {
  id          String   @id @default(uuid())
  sellerId    String
  type        PaymentMethodType
  // Encrypted sensitive data (card last4, bank IBAN, crypto address, etc.)
  details     Json
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  seller      SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@unique([sellerId, type])
  @@index([sellerId])
  @@map("seller_payment_methods")
}

enum PaymentMethodType {
  CARD
  BANK_TRANSFER
  CRYPTO
  PAYPAL
  WISE
  PAYONEER
}

/// One user's acceptance of the EMART Seller Agreement (Phase 8). The
/// version is always assigned server-side from the current agreement — the
/// client never supplies it. Re-acceptance is required whenever the
/// server-controlled version changes.
model SellerAgreementAcceptance {
  id         String   @id @default(uuid())
  userId     String   @unique
  version    String
  acceptedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("seller_agreement_acceptances")
}

enum SellerStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

model WalletTransaction {
  id             String            @id @default(uuid())
  userId         String
  walletId       String
  type           TransactionType
  amount         Float
  balanceBefore  Float
  balanceAfter   Float
  status         TransactionStatus @default(PENDING)
  description    String
  reference      String?
  paymentMethod  String?
  paymentDetails Json?
  notes          String?
  processedAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  user           User              @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([walletId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@map("wallet_transactions")
}

enum UserRole {
  CUSTOMER
  /// Approved seller: seller-only account (Seller Center). Cannot use the
  /// buyer purchasing flow. Written by the admin approval flow; the seller
  /// application/profile status remains the authority for seller access.
  SELLER
  ADMIN
}

enum SourceType {
  SELLER
  CJ
}

enum ProductCondition {
  NEW
  LIKE_NEW
  VERY_GOOD
  GOOD
  ACCEPTABLE
}

enum SellerType {
  SHOP
  INDIVIDUAL
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PURCHASING
  PURCHASED
  IN_WAREHOUSE
  CONSOLIDATED
  SHIPPED
  IN_TRANSIT
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PackageStatus {
  RECEIVED
  INSPECTED
  STORED
  READY_TO_SHIP
  CONSOLIDATED
  SHIPPED
  DELIVERED
}

enum ShipmentStatus {
  PENDING
  PROCESSING
  SHIPPED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  RETURNED
}

enum ImportMode {
  CREATE
  UPDATE
  UPSERT
}

enum ImportStatus {
  PROCESSING
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  PAYMENT
  REFUND
  BONUS
  ADJUSTMENT
}

enum TransactionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
  @@index([userId, createdAt])
  @@map("favorites")
}

/// One user's 1-5 star rating for a product; unique per (user, product) so
/// re-rating updates the existing row instead of creating a duplicate.
model ProductRating {
  id        String   @id @default(uuid())
  userId    String
  productId String
  rating    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
  @@index([userId])
  @@map("product_ratings")
}

/// Admin ↔ Seller order-specific messaging (Phase 7).
///
/// An EMART order can, at the data level, contain items from several sellers
/// (items link to Product, Product carries an optional sellerId → SellerProfile).
/// A conversation therefore belongs to one (order, seller) pair — one
/// conversation per order+seller, enforced by the @@unique([orderId, sellerId])
/// constraint. The customer who placed the order has no relation to it.
model Conversation {
  id            String         @id @default(uuid())
  orderId       String
  sellerId      String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  seller        SellerProfile  @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  messages      Message[]
  notifications Notification[]

  @@unique([orderId, sellerId])
  @@index([orderId])
  @@index([sellerId, updatedAt])
  @@map("conversations")
}

/// A single message inside a conversation. `readAt` records when the RECIPIENT
/// read the message (it is set when the opposite side opens/marks the thread as
/// read); a null `readAt` means the recipient has not read it yet.
model Message {
  id             String       @id @default(uuid())
  conversationId String
  senderUserId   String
  body           String
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("SenderMessages", fields: [senderUserId], references: [id], onDelete: Cascade)
  notifications  Notification[]

  @@index([conversationId])
  @@index([conversationId, createdAt])
  @@index([senderUserId])
  @@map("messages")
}

/// User-targeted in-app notification (Phase 7). Sellers receive a notification
/// when the admin sends a message; admins receive one when a seller replies.
model Notification {
  id                 String                 @id @default(uuid())
  userId             String
  type               String
  title              String
  body               String?
  orderId            String?
  conversationId     String?
  messageId          String?
  supportConversationId String?
  supportMessageId   String?
  shipmentId         String?
  /// Order-request workflow state, independent of `readAt`.
  ///
  /// Only meaningful for `type = 'ORDER_REQUEST'`, where this notification row
  /// IS the order-request record (there is no separate OrderRequest table) and
  /// the seller confirms it by notification id. `readAt` answers "has the seller
  /// seen this?"; this field answers "has the seller acted on it?", so simply
  /// reading a notification can never retire a request. NULL for every other
  /// notification type.
  requestStatus      String?
  /// When the seller accepted/declined the request. NULL while undecided.
  requestRespondedAt DateTime?
  readAt             DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  user               User                   @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  order              Order?                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  conversation       Conversation?          @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message            Message?               @relation(fields: [messageId], references: [id], onDelete: SetNull)
  supportConversation SupportConversation?  @relation(fields: [supportConversationId], references: [id], onDelete: Cascade)
  supportMessage     SupportMessage?        @relation(fields: [supportMessageId], references: [id], onDelete: SetNull)
  shipment           Shipment?              @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([readAt])
  @@index([shipmentId])
  // Serves the seller order-request queue, which is a filtered lookup on
  // (type, requestStatus) scoped to the recipient — not a readAt scan.
  @@index([userId, type, requestStatus])
  @@map("notifications")
}

/// Customer ↔ Admin support chat (general support, not order-specific).
model SupportConversation {
  id          String            @id @default(uuid())
  userId      String
  status      SupportStatus     @default(OPEN)
  subject     String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  user        User              @relation("UserSupportConversations", fields: [userId], references: [id], onDelete: Cascade)
  messages    SupportMessage[]
  notifications Notification[]

  @@index([userId])
  @@index([status])
  @@map("support_conversations")
}

/// A single message inside a support conversation. `readAt` records when the
/// RECIPIENT read the message; a null `readAt` means the recipient has not read it yet.
model SupportMessage {
  id                  String               @id @default(uuid())
  conversationId      String
  senderUserId        String
  body                String
  readAt              DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  conversation        SupportConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender              User                 @relation("SenderSupportMessages", fields: [senderUserId], references: [id], onDelete: Cascade)
  notifications       Notification[]

  @@index([conversationId])
  @@index([conversationId, createdAt])
  @@index([senderUserId])
  @@map("support_messages")
}

enum SupportStatus {
  OPEN
  CLOSED
  RESOLVED
}

enum LoanRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model LoanRequest {
  id                          String             @id @default(uuid())
  customerId                  String
  requestedAmount             Float
  loanPurpose                 String
  repaymentPeriod             Int?
  status                      LoanRequestStatus  @default(PENDING)
  submittedAt                 DateTime           @default(now())
  reviewedAt                  DateTime?
  reviewedByAdminId           String?
  decisionNote                String?
  createdAt                   DateTime           @default(now())
  updatedAt                   DateTime           @updatedAt

  interestRate                Float              @default(0.001)
  interestAmount              Float              @default(0)
  totalRepaymentBeforePenalties Float            @default(0)
  dueDate                     DateTime?
  outstandingPrincipal        Float              @default(0)
  accruedPenalty              Float              @default(0)
  lastPenaltyCalculatedAt     DateTime?
  fullyRepaidAt               DateTime?
  principalRepaid             Float              @default(0)
  interestRepaid              Float              @default(0)
  penaltyRepaid               Float              @default(0)

  customer                    User               @relation(fields: [customerId], references: [id], onDelete: Cascade)
  reviewedByAdmin             User?              @relation("LoanRequestReviewedBy", fields: [reviewedByAdminId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([status])
  @@index([submittedAt])
  @@index([dueDate])
  @@map("loan_requests")
}
